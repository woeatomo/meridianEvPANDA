{
  "_readme": [
    "EvilPanda fork of the standalone Meridian bot. Copy to user-config.json and edit; restart after changes.",
    "shadowMode: true forces DRY_RUN (nothing is submitted). Set false only after reviewing shadow results.",
    "Secrets go in .env, never here: RPC_URL, WALLET_PRIVATE_KEY, GMGN_API_KEY, LLM_API_KEY, TELEGRAM_*.",
    "Omitted keys fall back to defaults in config.js (buildEvilPandaConfig for the evilPanda block)."
  ],
  "shadowMode": true,
  "walletAddress": "",

  "maxPositions": 3,
  "deployAmountSol": 0.4,
  "positionSizePct": 0.35,
  "maxDeployAmount": 50,
  "minSolToOpen": 0.2,
  "gasReserve": 0.2,

  "minBinStep": 80,
  "maxBinStep": 250,
  "minTvl": 10000,
  "maxTvl": null,
  "timeframe": "5m",
  "minFeeActiveTvlRatio": 0,

  "stopLossPct": -15,
  "takeProfitPct": 5,
  "trailingTakeProfit": true,
  "trailingTriggerPct": 3,
  "trailingDropPct": 1.5,
  "minClaimAmount": 5,
  "autoSwapAfterClaim": true,
  "solMode": true,

  "repeatDeployCooldownEnabled": true,
  "repeatDeployCooldownTriggerCount": 3,
  "repeatDeployCooldownHours": 12,
  "repeatDeployCooldownScope": "token",
  "oorCooldownTriggerCount": 3,
  "oorCooldownHours": 12,

  "managementIntervalMin": 10,
  "pnlSource": "meteora",
  "pnlPollIntervalSec": 3,
  "pnlConfirmTicks": 2,

  "walletThreshold": 2,
  "walletWindowSec": 120,
  "minSmartWalletDepositSol": 0.1,

  "evilPanda": {
    "enabled": true,
    "sources": { "screener": true, "discord": true, "smartWallet": true },

    "screener": {
      "intervalMin": 5,
      "minMcap": 250000,
      "maxMcap": null,
      "minTokenVolume24h": 1000000,
      "minPoolVolume": 10000,
      "timeframe": "24h",
      "category": "trending",
      "requireProfile": true,
      "requireSocials": false,
      "sortBy": "fee_active_tvl",
      "minTokenAgeHours": 12,
      "maxTokenAgeHours": null
    },
    "filters": { "minTokenFeesSol": 30, "maxTop10Pct": 30 },

    "rugcheck": {
      "enabled": true,
      "maxScore": 10,
      "rejectDanger": true,
      "blockRisks": ["Low amount of LP Providers", "Creator history of rugged tokens"],
      "requireData": true
    },
    "gmgn": {
      "enabled": true,
      "maxPhishingPct": 30,
      "maxBundlerPct": 60,
      "maxInsidersPct": 10,
      "maxTop10Pct": 30,
      "ratesAreFractions": true,
      "requireData": false,
      "requestDelayMs": 2500,
      "fallback": { "enabled": true, "maxBotHoldersPct": 30, "requireBotData": true, "blockRugcheckInsiders": true, "insiderPattern": "insider" }
    },
    "discord": { "pollSec": 60 },

    "chart": {
      "source": "top_pool",
      "timeframeMin": 15,
      "stPeriod": 10,
      "stMultiplier": 3,
      "rsiPeriod": 2,
      "rsiUpper": 90,
      "bbPeriod": 20,
      "bbStdDev": 2,
      "macdFast": 12,
      "macdSlow": 26,
      "macdSignal": 9
    },
    "entry": {
      "mode": "breakout",
      "signalWindowCandles": 16,
      "pullbackRetracePct": 10,
      "afterPumpPct": 30,
      "nearStPct": 3,
      "nearWindowCandles": 48,
      "maxPriceMovePct": 5,
      "maxEntryDelayMin": 5,
      "watchlistTtlHours": 6,
      "rescreenMin": 30
    },
    "range": {
      "mode": "adaptive",
      "targetDownsidePct": 85,
      "minDownsidePct": 50,
      "shrinkToInitialized": true,
      "adaptive": {
        "minDepthPct": 50,
        "maxDepthPct": 85,
        "capDepthPct": 90,
        "atrPeriod": 14,
        "atrLowPct": 3,
        "atrHighPct": 7,
        "pumpLookbackCandles": 96,
        "pumpThresholdPct": 100,
        "pumpBoostPct": 10
      }
    },
    "pool": { "ranking": "expected_fee", "preferHighBinStep": true },
    "shape": {
      "default": "bid_ask",
      "autoSpot": true,
      "spot": {
        "minAgeHours": 72,
        "minMcap": 1000000,
        "maxVolatility": 3,
        "maxRugcheckScore": 1,
        "requireGmgn": true,
        "gmgnMarginPct": 50
      }
    },
    "exits": {
      "stConfluence": true,
      "oorAboveWaitMinutes": 30,
      "oorAboveMinPnlPct": 0,
      "oorBelowWaitMinutes": 60,
      "lowYieldMinFeePerTvl24h": 10,
      "lowYieldMinAgeMinutes": 60,
      "narrativeProxy": true,
      "minVolumeRatio": 0.5
    },
    "paper": { "enabled": true, "pollSec": 60, "nearSpanBins": 3, "virtualBalanceSol": 1.5 },
    "walletFinder": {
      "pools": 15,
      "minClosed": 30,
      "minWinRatePct": 70,
      "minMedianPnlPct": 0.35,
      "maxWorstPnlPct": -30,
      "auto": { "enabled": true, "intervalHours": 24, "maxWallets": 15, "addPerRun": 3, "inactiveDays": 3, "readdCooldownDays": 14 }
    },
    "llm": {
      "enabled": false,
      "baseUrl": "https://openrouter.ai/api/v1",
      "model": "deepseek/deepseek-chat",
      "timeoutMs": 20000,
      "onError": "allow",
      "useForEntry": true,
      "useForLowYield": true
    }
  }
}
